// Back-to-front order of the visible splats by a counting sort on view depth quantized to 2^16
// buckets over the object's depth range (sub-millimetre): clear, histogram, one-group scan, scatter.
// Order inside a bucket is arbitrary, which is invisible at that resolution.
#pragma kernel Clear
#pragma kernel Histogram
#pragma kernel Scan
#pragma kernel Scatter

#define BUCKETS 65536
#define SCAN_THREADS 1024

#include "../../GaussianData/ShaderLibrary/Gaussian.hlsl"
StructuredBuffer<Gaussian> _Deformed;
RWStructuredBuffer<uint> _Order;
RWStructuredBuffer<uint> _Keys;
RWStructuredBuffer<uint> _Buckets;
uint _SplatCount;
float3 _CameraPosition, _CameraForward;
float _DepthMin, _DepthScale; // bucket = (far edge - depth) * scale: farthest first
float4x4 _LocalToWorld;

[numthreads(256,1,1)] void Clear(uint i : SV_DispatchThreadID) { if (i < BUCKETS) _Buckets[i] = 0; }

[numthreads(256,1,1)] void Histogram(uint i : SV_DispatchThreadID)
{
    if (i >= _SplatCount) return;
    float depth = dot(mul(_LocalToWorld, float4(_Deformed[i].center.xyz, 1)).xyz - _CameraPosition, _CameraForward);
    uint key = (uint)clamp((depth - _DepthMin) * _DepthScale, 0, BUCKETS - 1);
    key = BUCKETS - 1 - key;
    _Keys[i] = key;
    InterlockedAdd(_Buckets[key], 1);
}

groupshared uint partial[SCAN_THREADS];
[numthreads(SCAN_THREADS,1,1)] void Scan(uint t : SV_GroupIndex)
{
    const uint span = BUCKETS / SCAN_THREADS;
    uint start = t * span, sum = 0;
    for (uint k = 0; k < span; k++) sum += _Buckets[start + k];
    partial[t] = sum;
    GroupMemoryBarrierWithGroupSync();
    // Hillis-Steele inclusive scan of the per-thread sums.
    for (uint offset = 1; offset < SCAN_THREADS; offset <<= 1)
    {
        uint add = t >= offset ? partial[t - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        partial[t] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    uint running = partial[t] - sum;
    for (uint k2 = 0; k2 < span; k2++) { uint c = _Buckets[start + k2]; _Buckets[start + k2] = running; running += c; }
}

[numthreads(256,1,1)] void Scatter(uint i : SV_DispatchThreadID)
{
    if (i >= _SplatCount) return;
    uint slot; InterlockedAdd(_Buckets[_Keys[i]], 1, slot);
    _Order[slot] = i;
}

