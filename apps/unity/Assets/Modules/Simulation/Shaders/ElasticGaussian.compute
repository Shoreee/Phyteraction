#pragma kernel Deform

#include "../../GaussianData/ShaderLibrary/Gaussian.hlsl"
StructuredBuffer<float4> _Position;
StructuredBuffer<uint> _VoxelNodes;
StructuredBuffer<float4> _VoxelOrigin;
StructuredBuffer<uint> _SplatVoxel;
StructuredBuffer<Gaussian> _Source;
RWStructuredBuffer<Gaussian> _Deformed;
uint _SplatCount;
float _Spacing;

[numthreads(64,1,1)] void Deform(uint i:SV_DispatchThreadID){
 if(i>=_SplatCount)return;
 // Splats outside kept voxels use linear extrapolation of their nearest voxel.
 Gaussian g=_Source[i];uint voxel=_SplatVoxel[i];float3 f=(g.center.xyz-_VoxelOrigin[voxel].xyz)/_Spacing;
 float3 p=0,dx=0,dy=0,dz=0;
 for(uint c=0;c<8;c++){
  uint x=c&1,y=(c>>1)&1,z=(c>>2)&1;
  float3 w=float3(x?f.x:1-f.x,y?f.y:1-f.y,z?f.z:1-f.z);
  float3 q=_Position[_VoxelNodes[voxel*8+c]].xyz;
  p+=q*w.x*w.y*w.z;
  dx+=q*(x?1:-1)*w.y*w.z/_Spacing;
  dy+=q*w.x*(y?1:-1)*w.z/_Spacing;
  dz+=q*w.x*w.y*(z?1:-1)/_Spacing;
 }
 // Covariance transport: Sigma' = F Sigma F^T, represented by three scaled axes.
 float3 a=g.axis0.xyz,b=g.axis1.xyz,c3=g.axis2.xyz;
 g.center.xyz=p;g.axis0.xyz=dx*a.x+dy*a.y+dz*a.z;
 g.axis1.xyz=dx*b.x+dy*b.y+dz*b.z;g.axis2.xyz=dx*c3.x+dy*c3.y+dz*c3.z;
 _Deformed[i]=g;
}
