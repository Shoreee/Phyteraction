// MLS-MPM port of PhysFlow / PhysGaussian (mpm_solver_warp): APIC transfer with quadratic
// B-splines, Kirchhoff stresses and return mappings of the seven PhysFlow materials, grid boundary
// conditions from the scene configs, and hand-bone colliders with friction and reaction impulses.
// Per substep: P2G (return mapping, stress, scatter, block marking) -> Args -> Grid (indirect,
// active 4^3 blocks only, momentum -> velocity in place) -> G2P -> Clear (indirect).
#pragma kernel P2G
#pragma kernel Args
#pragma kernel Grid
#pragma kernel G2P
#pragma kernel Clear
#pragma kernel Deform

struct Particle { float4 x, v, c0, c1, c2, f0, f1, f2, r0, r1, r2; };
// x.w volume, v.w mass, c0.w yield stress (Pa), c1.w modifier mask bits, c2.w impulse gain,
// f0.w release time, f1.w damage; F (elastic) and R (render deformation) stored by rows.
struct Shape { float4 a, b, va, vb, ax, ay, az, he; }; // a.w radius, b.w isBox
struct Modifier { float4 pos, size, vec, normal, h1, h2; }; // pos.w type, size.w start, vec.w end, normal.w rotation, h1.w translation
struct Cuboid { float4 pos, size, velocity; };            // pos.w start, size.w end
struct Axle { float4 pos, normal; };                      // pos.w radius, normal.w half height
struct Gaussian { float4 center; float4 axis0; float4 axis1; float4 axis2; float4 color; };

RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<uint> _Grid;         // 4 floats (as bits) per node: momentum, mass; velocity after Grid
RWStructuredBuffer<uint> _BlockFlag, _BlockList, _Counter, _Args;
RWStructuredBuffer<uint> _Reaction;     // 8 per shape: impulse xyz, magnitude, moment xyz
StructuredBuffer<Shape> _Shapes;
StructuredBuffer<Modifier> _Modifiers;
StructuredBuffer<Cuboid> _Cuboids;
StructuredBuffer<Axle> _Axles;
StructuredBuffer<Gaussian> _Source;
RWStructuredBuffer<Gaussian> _Deformed;
StructuredBuffer<uint> _SplatParticle;
StructuredBuffer<float4> _SplatOffset;
StructuredBuffer<uint> _Detached;      // per particle: no connection to an anchor (pieces broken off)

uint _ParticleCount, _GridN, _Blocks, _ShapeCount, _ModifierCount, _CuboidCount, _AxleCount, _Material, _Script, _Hardening, _DynamicCount, _RenderTotal;
float _Dx, _InvDx, _Dt, _Time, _ShapeTime, _Mu, _Lambda, _Viscosity, _FrictionAlpha, _Cohesion, _Xi, _Damping, _Friction, _Skin, _MaxPush, _MaxParticleSpeed, _FractureStrain, _FloorOffset;
uint _Floor, _GravityMode; // gravity: 0 none, 1 all particles, 2 detached pieces only, 3 detached or hand-touched material
// Mass scaling (explicit FEM practice): inertia x _MassScale raises the stable step; static stiffness is unchanged.
float _MassScale;
float3 _FloorNormal;
float3 _ShapeLo, _ShapeHi; // bounds of all shapes over the step, simulation units
float3 _Gravity;
float4x4 _LocalFromSim;
float4x4 _Basis;

static const float3x3 I3 = float3x3(1,0,0, 0,1,0, 0,0,1);
float3x3 Rows(float4 a, float4 b, float4 c) { return float3x3(a.xyz, b.xyz, c.xyz); }
float3x3 Outer(float3 a, float3 b) { return float3x3(a.x * b, a.y * b, a.z * b); }
float3x3 Columns(float3 a, float3 b, float3 c) { return transpose(float3x3(a, b, c)); }
float3x3 Diag(float3 d) { return float3x3(d.x,0,0, 0,d.y,0, 0,0,d.z); }

// P2G accumulates in fixed point with native integer atomics (float adds would need CAS loops
// that retry under contention). Quanta: 2^23 per heaviest particle mass (and per that mass at a
// reference speed for momentum), leaving ~250 particle masses of headroom per node.
float _FixedMass, _FixedMomentum;
void FixedAdd(uint address, float value, float scale)
{
    InterlockedAdd(_Grid[address], asuint((int)round(clamp(value * scale, -2.0e9, 2.0e9))));
}
void ReactionAdd(uint address, float value)
{
    uint expected = _Reaction[address], original;
    [allow_uav_condition] for (uint i = 0; i < 4096; i++)
    {
        InterlockedCompareExchange(_Reaction[address], expected, asuint(asfloat(expected) + value), original);
        if (original == expected) break;
        expected = original;
    }
}

// ---- SVD: F = U diag(s) V^T with U, V proper rotations; s.z is negative for inverted F. ----
void Jacobi(inout float3x3 a, inout float3x3 q, int p, int r)
{
    float apr = a[p][r];
    if (abs(apr) < 1e-20) return;
    float theta = (a[r][r] - a[p][p]) / (2 * apr);
    float t = (theta >= 0 ? 1 : -1) / (abs(theta) + sqrt(theta * theta + 1));
    float c = rsqrt(t * t + 1), s = t * c;
    float3x3 j = I3; j[p][p] = c; j[r][r] = c; j[p][r] = s; j[r][p] = -s;
    a = mul(transpose(j), mul(a, j)); q = mul(q, j);
}
void Svd(float3x3 f, out float3x3 u, out float3 s, out float3x3 v)
{
    float3x3 a = mul(transpose(f), f), q = I3;
    [unroll] for (int sweep = 0; sweep < 4; sweep++) { Jacobi(a, q, 0, 1); Jacobi(a, q, 0, 2); Jacobi(a, q, 1, 2); }
    float3 e = float3(a[0][0], a[1][1], a[2][2]);
    float3 v0 = float3(q[0][0], q[1][0], q[2][0]), v1 = float3(q[0][1], q[1][1], q[2][1]), v2 = float3(q[0][2], q[1][2], q[2][2]), tv; float te;
    if (e.y > e.x) { te = e.x; e.x = e.y; e.y = te; tv = v0; v0 = v1; v1 = tv; }
    if (e.z > e.x) { te = e.x; e.x = e.z; e.z = te; tv = v0; v0 = v2; v2 = tv; }
    if (e.z > e.y) { te = e.y; e.y = e.z; e.z = te; tv = v1; v1 = v2; v2 = tv; }
    v2 = cross(v0, v1);
    float3 fv0 = mul(f, v0), fv1 = mul(f, v1), fv2 = mul(f, v2);
    float s0 = length(fv0);
    float3 u0 = s0 > 1e-12 ? fv0 / s0 : float3(1, 0, 0);
    float3 w = fv1 - dot(u0, fv1) * u0; float lw = length(w);
    float3 u1 = lw > 1e-12 ? w / lw : normalize(abs(u0.x) < .9 ? cross(u0, float3(1, 0, 0)) : cross(u0, float3(0, 1, 0)));
    float3 u2 = cross(u0, u1);
    s = float3(s0, dot(u1, fv1), dot(u2, fv2));
    u = Columns(u0, u1, u2); v = Columns(v0, v1, v2);
}

// ---- Return mappings (mpm_utils.py) ----
float3x3 VonMises(float3x3 f, inout float yieldStress)
{
    float3x3 u, v; float3 sig; Svd(f, u, sig, v);
    sig = max(sig, .01); float3 eps = log(sig); float tr = eps.x + eps.y + eps.z;
    float3 tau = 2 * _Mu * eps + _Lambda * tr; float3 dev = tau - (tau.x + tau.y + tau.z) / 3;
    if (length(dev) <= yieldStress) return f;
    float3 epsHat = eps - tr / 3; float n = length(epsHat) + 1e-6;
    float dg = n - yieldStress / (2 * _Mu);
    eps -= dg / n * epsHat;
    if (_Hardening != 0) yieldStress += 2 * _Mu * _Xi * dg;
    return mul(u, mul(Diag(exp(eps)), transpose(v)));
}
float3x3 Viscoplastic(float3x3 f, float yieldStress, float dt, bool always)
{
    float3x3 u, v; float3 sig; Svd(f, u, sig, v);
    sig = max(sig, .01); float3 b = sig * sig; float3 eps = log(sig); float tr = eps.x + eps.y + eps.z;
    float3 s = 2 * _Mu * (eps - tr / 3); float sn = length(s);
    float y = sn - sqrt(2.0 / 3.0) * yieldStress;
    if ((!always && y <= 0) || sn < 1e-12) return f;
    float muHat = _Mu * (b.x + b.y + b.z) / 3;
    float sNew = sn - y / (1 + _Viscosity / (2 * muHat * dt));
    float3 epsNew = sNew / sn * s / (2 * _Mu) + tr / 3;
    return mul(u, mul(Diag(exp(epsNew)), transpose(v)));
}
float3x3 Sand(float3x3 f)
{
    float3x3 u, v; float3 sig; Svd(f, u, sig, v);
    // Cohesion (log strain) shifts the cone apex into tension; zero reproduces PhysFlow.
    float3 eps = log(max(abs(sig), 1e-14)) - _Cohesion / 3; float tr = eps.x + eps.y + eps.z;
    float3 epsHat = eps - tr / 3; float n = length(epsHat);
    float dg = n + (3 * _Lambda + 2 * _Mu) / (2 * _Mu) * tr * _FrictionAlpha;
    if (dg <= 0) return f;
    if (tr > 0) return mul(u, mul(Diag(exp(float3(1, 1, 1) * _Cohesion / 3)), transpose(v)));
    float3 h = eps - epsHat * (dg / max(n, 1e-12)) + _Cohesion / 3;
    return mul(u, mul(Diag(exp(h)), transpose(v)));
}
float3x3 Stress(float3x3 f, float damage)
{
    float3x3 u, v; float3 sig; Svd(f, u, sig, v);
    float j = determinant(f);

    float3x3 tau;
    if (_Material == 0) // fixed corotated
        tau = 2 * _Mu * mul(f - mul(u, transpose(v)), transpose(f)) + I3 * (_Lambda * j * (j - 1));
    else if (_Material == 2) // Drucker-Prager (Hencky)
    {
        sig = max(abs(sig), 1e-6); float3 l = log(sig); float t = l.x + l.y + l.z;
        tau = mul(u, mul(Diag((2 * _Mu * l + _Lambda * t) / sig), mul(transpose(v), transpose(f))));
    }
    else // StVK in Hencky strain, as PhysGaussian: U diag(tau) V^T F^T
    {
        sig = max(sig, .01); float3 l = log(sig); float t = l.x + l.y + l.z;
        tau = mul(u, mul(Diag(2 * _Mu * l + _Lambda * t), mul(transpose(v), transpose(f))));
    }
    tau = (tau + transpose(tau)) * .5;
    // Broken material keeps only its resistance to compression.
    if (damage > 0) tau = (1 - damage) * tau + damage * I3 * (_Lambda * j * min(j - 1, 0));
    return tau;
}

void Weights(float3 x, out int3 base, out float3 fx, out float3 w[3], out float3 dw[3])
{
    float3 g = x * _InvDx; base = int3(g - .5); fx = g - base;
    w[0] = .5 * (1.5 - fx) * (1.5 - fx); w[1] = .75 - (fx - 1) * (fx - 1); w[2] = .5 * (fx - .5) * (fx - .5);
    dw[0] = fx - 1.5; dw[1] = -2 * (fx - 1); dw[2] = fx - .5;
}
uint Node(int3 c) { c = clamp(c, 0, (int)_GridN - 1); return (uint)c.x + _GridN * ((uint)c.y + _GridN * (uint)c.z); }
void Mark(int3 node)
{
    uint bn = _GridN / 4; int3 b = clamp(node >> 2, 0, (int)bn - 1); uint id = (uint)b.x + bn * ((uint)b.y + bn * (uint)b.z);
    if (_BlockFlag[id] != 0) return;
    uint old; InterlockedOr(_BlockFlag[id], 1, old);
    if (old == 0) { uint slot; InterlockedAdd(_Counter[0], 1, slot); _BlockList[slot] = id; }
}

[numthreads(64,1,1)] void P2G(uint p : SV_DispatchThreadID)
{
    if (p >= _ParticleCount) return;
    Particle q = _Particles[p];
    float3 x = q.x.xyz, v = q.v.xyz; float mass = q.v.w * _MassScale, volume = q.x.w, yieldStress = q.c0.w;
    // PhysFlow scripted interactions (pre-P2G particle velocity modifiers), masks set at rest.
    if (_Script != 0)
    {
        uint mask = asuint(q.c1.w);
        for (uint k = 0; k < _ModifierCount; k++)
        {
            if ((mask & (1u << k)) == 0) continue;
            Modifier m = _Modifiers[k]; uint type = (uint)m.pos.w;
            if (type == 0) { if (_Time >= m.size.w && _Time - _Dt < m.size.w) v += m.vec.xyz * q.c2.w; }
            else if (_Time >= m.size.w && _Time < m.vec.w)
            {
                if (type == 1) v = m.vec.xyz;
                else
                {
                    float3 o = x - m.pos.xyz;
                    v = m.normal.w * (dot(o, m.h1.xyz) * m.h2.xyz - dot(o, m.h2.xyz) * m.h1.xyz) + m.h1.w * m.normal.xyz;
                }
            }
        }
        if (_Time < q.f0.w) v = 0;
    }
    // Sand or jam a hand has disturbed (f2.w) falls; untouched material keeps the scanned shape that
    // already carries its weight. Tying it to touch, not displacement, stops a collapse cascading.
    bool loose = _Detached[p] != 0 || (_GravityMode == 3 && q.f2.w > 0);
    if (_GravityMode == 1 || (_GravityMode >= 2 && loose)) v += _Dt * _Gravity;
    float3x3 f = Rows(q.f0, q.f1, q.f2);
    if (_Material == 1 || _Material == 4) f = VonMises(f, yieldStress);
    else if (_Material == 2) f = Sand(f);
    else if (_Material == 3) f = Viscoplastic(f, yieldStress, _Dt, false);
    else if (_Material == 6) f = Viscoplastic(f, yieldStress, _Dt, true);
    // Stretch-driven continuum damage (Rankine-type, cf. CD-MPM): irreversible softening past a
    // critical principal log stretch of the total deformation (plastic flow included).
    float damage = q.f1.w;
    if (_FractureStrain > 0 && damage < 1)
    {
        float3x3 du, dv; float3 ds; Svd(_RenderTotal != 0 ? Rows(q.r0, q.r1, q.r2) : f, du, ds, dv);
        float e = log(max(ds.x, 1e-6));
        if (e > _FractureStrain) damage = min(1, damage + (e - _FractureStrain) / (.25 * _FractureStrain));
    }
    float3x3 stress = Stress(f, damage);
    float3x3 c = Rows(q.c0, q.c1, q.c2);
    int3 base; float3 fx; float3 w[3], dw[3]; Weights(x, base, fx, w, dw);
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) for (int k = 0; k < 3; k++)
    {
        float weight = w[i].x * w[j].y * w[k].z;
        float3 grad = float3(dw[i].x * w[j].y * w[k].z, w[i].x * dw[j].y * w[k].z, w[i].x * w[j].y * dw[k].z) * _InvDx;
        float3 dpos = (float3(i, j, k) - fx) * _Dx;
        float3 momentum = weight * mass * (v + mul(c, dpos)) - _Dt * volume * mul(stress, grad);
        uint n = Node(base + int3(i, j, k)) * 4;
        FixedAdd(n, momentum.x, _FixedMomentum); FixedAdd(n + 1, momentum.y, _FixedMomentum); FixedAdd(n + 2, momentum.z, _FixedMomentum); FixedAdd(n + 3, weight * mass, _FixedMass);
    }
    for (int bx = 0; bx < 2; bx++) for (int by = 0; by < 2; by++) for (int bz = 0; bz < 2; bz++) Mark(base + int3(bx, by, bz) * 2);
    q.v.xyz = v; q.c0.w = yieldStress;
    q.f0.xyz = f[0]; q.f1.xyz = f[1]; q.f2.xyz = f[2]; q.f1.w = damage;
    _Particles[p] = q;
}

[numthreads(1,1,1)] void Args(uint id : SV_DispatchThreadID)
{
    _Args[0] = _Counter[0]; _Args[1] = 1; _Args[2] = 1; _Counter[0] = 0;
}

float Distance(Shape s, float3 x, out float3 n, out float3 velocity)
{
    if (s.b.w != 0)
    {
        float3 centre = s.a.xyz + s.va.xyz * _ShapeTime, d = x - centre;
        float3 l = float3(dot(d, s.ax.xyz), dot(d, s.ay.xyz), dot(d, s.az.xyz)), c = clamp(l, -s.he.xyz, s.he.xyz);
        velocity = s.va.xyz;
        if (any(l != c)) { float3 delta = d - (s.ax.xyz * c.x + s.ay.xyz * c.y + s.az.xyz * c.z); float dist = length(delta); n = delta / max(dist, 1e-9); return dist; }
        float3 gap = s.he.xyz - abs(l);
        if (gap.x < gap.y && gap.x < gap.z) { n = s.ax.xyz * sign(l.x); return -gap.x; }
        if (gap.y < gap.z) { n = s.ay.xyz * sign(l.y); return -gap.y; }
        n = s.az.xyz * sign(l.z); return -gap.z;
    }
    float3 a = s.a.xyz + s.va.xyz * _ShapeTime, ab = s.b.xyz + s.vb.xyz * _ShapeTime - a;
    float t = saturate(dot(x - a, ab) / max(dot(ab, ab), 1e-12));
    float3 delta = x - (a + t * ab); float dist = length(delta);
    n = dist > 1e-9 ? delta / dist : float3(0, 1, 0);
    velocity = lerp(s.va.xyz, s.vb.xyz, t);
    return dist - s.a.w;
}

void Reaction(uint id, float3 j, float3 x)
{
    float m = length(j); uint r = id * 8;
    ReactionAdd(r, j.x); ReactionAdd(r + 1, j.y); ReactionAdd(r + 2, j.z); ReactionAdd(r + 3, m);
    ReactionAdd(r + 4, m * x.x); ReactionAdd(r + 5, m * x.y); ReactionAdd(r + 6, m * x.z);
}

groupshared uint candidates[96];
groupshared uint candidateCount;

[numthreads(64,1,1)] void Grid(uint3 group : SV_GroupID, uint local : SV_GroupIndex)
{
    uint bn = _GridN / 4, block = _BlockList[group.x];
    uint3 b = uint3(block % bn, block / bn % bn, block / (bn * bn));
    if (local == 0) candidateCount = 0;
    GroupMemoryBarrierWithGroupSync();
    // Shapes whose bounds (at this substep) reach this 4^3 block.
    float3 lo = b * 4 * _Dx - _Skin, hi = (b * 4 + 3) * _Dx + _Skin;
    for (uint s = local; s < _ShapeCount; s += 64)
    {
        Shape sh = _Shapes[s]; float3 slo, shi;
        float3 a1 = sh.a.xyz + sh.va.xyz * _ShapeTime;
        if (sh.b.w != 0)
        {
            float3 e = abs(sh.ax.xyz) * sh.he.x + abs(sh.ay.xyz) * sh.he.y + abs(sh.az.xyz) * sh.he.z;
            slo = a1 - e; shi = a1 + e;
        }
        else
        {
            float3 b1 = sh.b.xyz + sh.vb.xyz * _ShapeTime;
            slo = min(a1, b1) - sh.a.w; shi = max(a1, b1) + sh.a.w;
        }
        if (all(shi >= lo) && all(slo <= hi)) { uint slot; InterlockedAdd(candidateCount, 1, slot); candidates[slot] = s; }
    }
    GroupMemoryBarrierWithGroupSync();
    uint3 c = b * 4 + uint3(local & 3, (local >> 2) & 3, local >> 4);
    uint node = c.x + _GridN * (c.y + _GridN * c.z), raw = node * 4;
    int quanta = asint(_Grid[raw + 3]);
    // A node with a few quanta of mass has a meaningless momentum/mass ratio; treat it as empty.
    if (quanta <= 16) { _Grid[raw] = 0; _Grid[raw + 1] = 0; _Grid[raw + 2] = 0; return; }
    float mass = quanta / _FixedMass;
    float3 momentum = float3(asint(_Grid[raw]), asint(_Grid[raw + 1]), asint(_Grid[raw + 2])) / _FixedMomentum;
    float3 x = c * _Dx, v = momentum / mass;
    v *= _Damping;
    // Hand bones: no approach along the contact normal, Coulomb friction, gentle bounded push-out.
    // Material squeezed between opposing bones (a pinch) sticks to them so it can be held.
    float3 n0 = 0, stick = 0; uint touching = 0, first = 0, second = 0; bool pinch = false;
    for (uint k = 0; k < candidateCount; k++)
    {
        uint id = candidates[k]; float3 n, vs; float d = Distance(_Shapes[id], x, n, vs);
        if (d >= _Skin) continue;
        if (touching == 0) { n0 = n; first = id; } else if (!pinch && dot(n, n0) < -.2) { pinch = true; second = id; }
        touching++; stick += vs;
        float3 vr = v - vs; float vn = dot(vr, n);
        float push = d < 0 ? min(-d / _Dt * .2, _MaxPush) : 0;
        if (vn >= push) continue;
        float3 vt = vr - vn * n; float lt = length(vt);
        float3 nv = vs + (lt > 1e-9 ? vt * max(0, 1 + _Friction * (vn - push) / lt) : 0) + n * push;
        Reaction(id, mass * (nv - v), x);
        v = nv;
    }
    if (pinch)
    {
        float3 j = mass * (stick / touching - v) * .5;
        Reaction(first, j, x); Reaction(second, j, x);
        v = stick / touching;
    }
    for (uint a = 0; a < _AxleCount; a++)
    {
        Axle ax = _Axles[a]; float3 o = x - ax.pos.xyz, nrm = ax.normal.xyz; float h = dot(o, nrm); float3 radial = o - h * nrm; float r = length(radial);
        if (abs(h) < ax.normal.w && r < ax.pos.w) { float3 t = r > 1e-6 ? cross(nrm, radial / r) : 0; v = t * dot(v, t); }
    }
    for (uint q = 0; q < _CuboidCount; q++)
    {
        Cuboid cb = _Cuboids[q];
        if (_Time >= cb.pos.w && _Time < cb.size.w && all(abs(x - cb.pos.xyz) < cb.size.xyz)) v = cb.velocity.xyz;
    }
    // Floor at the moving part's base: broken pieces land instead of drifting off.
    if (_Floor != 0 && dot(x, _FloorNormal) < _FloorOffset)
    {
        float vn = dot(v, _FloorNormal);
        if (vn < 0) { float3 vt = v - vn * _FloorNormal; float lt = length(vt); v = lt > 1e-9 ? vt * max(0, 1 + .8 * vn / lt) : 0; }
    }
    const uint padding = 3;
    if (c.x < padding && v.x < 0) v.x = 0; if (c.x >= _GridN - padding && v.x > 0) v.x = 0;
    if (c.y < padding && v.y < 0) v.y = 0; if (c.y >= _GridN - padding && v.y > 0) v.y = 0;
    if (c.z < padding && v.z < 0) v.z = 0; if (c.z >= _GridN - padding && v.z > 0) v.z = 0;
    _Grid[raw] = asuint(v.x); _Grid[raw + 1] = asuint(v.y); _Grid[raw + 2] = asuint(v.z);
}

[numthreads(64,1,1)] void Clear(uint3 group : SV_GroupID, uint local : SV_GroupIndex)
{
    uint bn = _GridN / 4, block = _BlockList[group.x];
    uint3 c = uint3(block % bn, block / bn % bn, block / (bn * bn)) * 4 + uint3(local & 3, (local >> 2) & 3, local >> 4);
    uint raw = (c.x + _GridN * (c.y + _GridN * c.z)) * 4;
    _Grid[raw] = 0; _Grid[raw + 1] = 0; _Grid[raw + 2] = 0; _Grid[raw + 3] = 0;
    if (local == 0) _BlockFlag[block] = 0;
}

[numthreads(64,1,1)] void G2P(uint p : SV_DispatchThreadID)
{
    if (p >= _ParticleCount) return;
    Particle q = _Particles[p];
    if (_GravityMode == 3 && q.f2.w == 0)
        for (uint s = 0; s < _ShapeCount; s++)
        {
            float3 n, sv;
            if (Distance(_Shapes[s], q.x.xyz, n, sv) < _Skin + _Dx) { q.f2.w = 1; break; }
        }
    int3 base; float3 fx; float3 w[3], dw[3]; Weights(q.x.xyz, base, fx, w, dw);
    float3 v = 0; float3x3 c = 0, gradV = 0;
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) for (int k = 0; k < 3; k++)
    {
        float weight = w[i].x * w[j].y * w[k].z;
        float3 grad = float3(dw[i].x * w[j].y * w[k].z, w[i].x * dw[j].y * w[k].z, w[i].x * w[j].y * dw[k].z) * _InvDx;
        uint n = Node(base + int3(i, j, k)) * 4;
        float3 gv = float3(asfloat(_Grid[n]), asfloat(_Grid[n + 1]), asfloat(_Grid[n + 2]));
        v += weight * gv; c += Outer(gv, float3(i, j, k) - fx) * (weight * _InvDx * 4); gradV += Outer(gv, grad);
    }
    float speed = length(v); if (speed > _MaxParticleSpeed) v *= _MaxParticleSpeed / speed;
    float3x3 step = I3 + _Dt * gradV;
    float3x3 f = mul(step, Rows(q.f0, q.f1, q.f2)), r = mul(step, Rows(q.r0, q.r1, q.r2));
    float3 x = q.x.xyz + _Dt * v;
    // Particle-level contact: grid nodes are 1-2 cm apart, a fingertip about as wide, so the grid
    // alone lets a fast finger slip between nodes. Particles that end up inside a bone are put back
    // on its surface and lose their approach velocity (the impulse counts as reaction).
    if (_ShapeCount > 0 && all(x >= _ShapeLo) && all(x <= _ShapeHi))
        for (uint s = 0; s < _ShapeCount; s++)
        {
            float3 n, vs; float d = Distance(_Shapes[s], x, n, vs);
            if (d >= 0) continue;
            x -= d * n;
            float vn = dot(v - vs, n);
            if (vn < 0) { v -= vn * n; Reaction(s, -q.v.w * _MassScale * vn * n, x); }
        }
    q.x.xyz = clamp(x, 3 * _Dx, (_GridN - 4) * _Dx);
    q.v.xyz = v;
    q.c0.xyz = c[0]; q.c1.xyz = c[1]; q.c2.xyz = c[2];
    q.f0.xyz = f[0]; q.f1.xyz = f[1]; q.f2.xyz = f[2];
    q.r0.xyz = r[0]; q.r1.xyz = r[1]; q.r2.xyz = r[2];
    _Particles[p] = q;
}

// Moving Gaussians ride on their bound particle: x = x_p + F d, Sigma' = F Sigma F^T, in object space.
// Fully damaged material has no shear stiffness and F can stretch without bound; its splats keep
// at most twice (or a third of) their rest length instead of smearing across the view.
float3 Stretch(float3x3 a, float3 axis)
{
    float3 n = mul(a, axis); float rest = length(axis), now = length(n);
    return now > 1e-12 ? n * (clamp(now / max(rest, 1e-12), .3, 2) * rest / now) : axis;
}
[numthreads(64,1,1)] void Deform(uint i : SV_DispatchThreadID)
{
    if (i >= _DynamicCount) return;
    Gaussian g = _Source[i]; Particle q = _Particles[_SplatParticle[i]];
    float3x3 f = _RenderTotal != 0 ? Rows(q.r0, q.r1, q.r2) : Rows(q.f0, q.f1, q.f2);
    float3 x = q.x.xyz + mul(f, _SplatOffset[i].xyz);
    float3x3 basis = (float3x3)_Basis, a = mul(basis, mul(f, transpose(basis)));
    g.center.xyz = mul(_LocalFromSim, float4(x, 1)).xyz;
    g.axis0.xyz = Stretch(a, g.axis0.xyz); g.axis1.xyz = Stretch(a, g.axis1.xyz); g.axis2.xyz = Stretch(a, g.axis2.xyz);
    _Deformed[i] = g;
}
