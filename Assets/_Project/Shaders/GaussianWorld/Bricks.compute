// Moving splats ride rigidly on their brick: x' = M x, axes' = M axes, M = brick pose * rest pose^-1 (object space).
#pragma kernel Rigid

struct Gaussian { float4 center; float4 axis0; float4 axis1; float4 axis2; float4 color; };
StructuredBuffer<Gaussian> _Source;
RWStructuredBuffer<Gaussian> _Deformed;
StructuredBuffer<uint> _SplatBrick;
StructuredBuffer<float4x4> _Poses;
uint _Count;

[numthreads(64,1,1)] void Rigid(uint i : SV_DispatchThreadID)
{
    if (i >= _Count) return;
    Gaussian g = _Source[i]; float4x4 m = _Poses[_SplatBrick[i]];
    g.center.xyz = mul(m, float4(g.center.xyz, 1)).xyz;
    g.axis0.xyz = mul((float3x3)m, g.axis0.xyz); g.axis1.xyz = mul((float3x3)m, g.axis1.xyz); g.axis2.xyz = mul((float3x3)m, g.axis2.xyz);
    _Deformed[i] = g;
}
